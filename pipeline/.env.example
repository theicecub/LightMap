# ── Neon Postgres (бесплатный тариф) ────────────────────────────────────────
# https://console.neon.tech → Project Settings → Connection string
# Строка вида: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Mapillary (бесплатно, CC BY-SA 4.0) ──────────────────────────────────────────
# https://mapillary.com → Developers → Create token → User Access Token
MAPILLARY_ACCESS_TOKEN=

# ── Groq free tier (единственный ИИ-шаг: классификация фасада) ─────────────────────
# https://console.groq.com → API Keys
GROQ_API_KEY=

# Опционально: переопределить модель, если qwen/qwen3.6-27b депрекейтнут.
# Актуальный список vision-моделей: https://console.groq.com/docs/models
# GROQ_VISION_MODEL=
